# ShadowDev server settings. Copy to .env and fill in. Real environment variables override this file.
# Projects are added by developers on the web page; nothing about them goes here.

# Jira sites developers may sign in with and add projects on, comma-separated,
# e.g. the office site and developers' personal ones. "*" allows any site (anyone with an
# Atlassian account could then use this server and its machine).
JIRA_SITES=https://your-company.atlassian.net

# The ShadowDev OAuth app from https://developer.atlassian.com/console/myapps/ (see README).
# Its callback URL: PUBLIC_URL/oauth/jira/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
PUBLIC_URL=http://localhost:8080

# Encrypts developers' tokens in data/shadowdev.db. Keep it stable, and a copy somewhere safe.
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHADOWDEV_SECRET_KEY=

# Optional: the secret of the shared /webhook (one Jira webhook per site for all its projects).
# Each project also has its own webhook URL and secret, shown to its owner on the web page.
WEBHOOK_SECRET=

HOST=127.0.0.1
PORT=8080
MAX_FIX_ATTEMPTS=3
MAX_PARALLEL_RUNS=5
